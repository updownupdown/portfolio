{
  "name": "portfolio",
  "version": "1.0.0",
  "homepage": "https://www.jamescarmichael.ca",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:next": "tsc -b && vite build --base=/next/ --outDir dist-next",
    "deploy:next": "npm run build:next && gh-pages -d dist-next -e next --add -m \"Stage new portfolio at /next\""
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
